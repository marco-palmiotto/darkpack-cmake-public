{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/Test/scalar_computation.x",
            "args": ["${workspaceFolder}/src/models/scalar.lha", "${workspaceFolder}/out/scans/input_to_test.dat", "${workspaceFolder}/out/scans/output_from_test.out"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build", // Make sure the build task runs before debugging
            "miDebuggerPath": "/usr/bin/gdb", // Path to your gdb debugger
            "targetArchitecture": "x86_64",
            "internalConsoleOptions": "openOnSessionStart",
            "logging": { "engineLogging": false },
            "debugServerPath": ""
        }
    ]
}
