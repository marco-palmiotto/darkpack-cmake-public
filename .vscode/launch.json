    "version": "0.2.0",
    "configurations": [

        {
            "name": "(gdb) Launch-darkpack",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/Test/u1-scan-point-offline-weff.x",
            "args": ["${workspaceFolder}/src/models/u1.lha"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build", // Make sure the build task runs before debugging
            "miDebuggerPath": "/usr/bin/gdb", // Path to your gdb debugger
            "targetArchitecture": "x86_64",
            "internalConsoleOptions": "openOnSessionStart",
            "logging": { "engineLogging": false },
            "debugServerPath": ""
        },
        {
            "name": "(gdb) Launch-marty",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/models/MSSM.x",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "lib_generate", // You need to define this task in tasks.json
            "miDebuggerPath": "/usr/bin/gdb",
            "targetArchitecture": "x86_64",
            "internalConsoleOptions": "openOnSessionStart",
            "logging": { "engineLogging": false }
        },
        {
            "name": "(gdb) Launch-marty-scalar",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/models/scalar.x",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "lib_generate_scalar", // You need to define this task in tasks.json
            "miDebuggerPath": "/usr/bin/gdb",
            "targetArchitecture": "x86_64",
            "internalConsoleOptions": "openOnSessionStart",
            "logging": { "engineLogging": false }
        }
    ]
}
